# Navyr Deploy — Environment Variables
# Copy to .env and fill in the required values.
# Lines marked with :? will cause docker compose to fail if not set.

# ── Image version ────────────────────────────────────────────────────────────
# Pin to a specific image tag (e.g. sha-abc1234) or leave as "latest".
NAVYR_VERSION=latest

# ── PostgreSQL ───────────────────────────────────────────────────────────────
NAVYR_POSTGRES_USER=navyr
NAVYR_POSTGRES_PASSWORD=change-me
NAVYR_POSTGRES_DB=navyr

# ── Secrets (required) ───────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32

# Shared JWT signing key — must be identical across gateway, auth, orchestrator
NAVYR_JWT_SECRET=

# Signs X-Internal-Context header between gateway and orchestrator
NAVYR_INTERNAL_SECRET=

# AES-256 key for cluster credential envelope encryption (orchestrator)
NAVYR_CREDENTIAL_KEY=
NAVYR_CREDENTIAL_KEY_ID=local

# Single-use WebSocket exec ticket signing key (orchestrator)
NAVYR_WS_TICKET_SECRET=

# AES-256 key for TOTP secrets at rest (auth)
NAVYR_TOTP_KEY=

# AES-256 key for AI provider API keys at rest (auth)
NAVYR_AI_PROVIDER_KEY=

# Community service signing key
COMMUNITY_SECRETS_KEY=

# ── URLs ─────────────────────────────────────────────────────────────────────
NAVYR_FRONTEND_URL=http://localhost:5173
NAVYR_CORS_ORIGINS=http://localhost:5173

# ── Kubeconfig ───────────────────────────────────────────────────────────────
# Directory containing your kubeconfig (mounted read-only into orchestrator)
NAVYR_KUBECONFIG_DIR=~/.kube
# Optional: specific context to use
K8S_CONTEXT=

# ── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── GitHub OAuth for community (optional) ────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Collector ────────────────────────────────────────────────────────────────
# Interval between cluster state collection cycles.
COLLECTOR_INTERVAL=30s

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Redis runs by default (required by the collector event stream).
# REDIS_URL only needs setting when pointing at an external Redis.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://redis:6379
# Session store. Defaults to the bundled Redis; set it only when pointing at an
# external one, and keep it in sync with REDIS_URL.
REDIS_SESSION_URL=redis://redis:6379

# ── Agent tunnel endpoint ────────────────────────────────────────────────────
# The address your CLUSTER uses to reach the orchestrator — not the address you
# use in the browser. It is almost never localhost: the agent runs inside the
# cluster, so localhost there is the pod itself.
#
# The default below (172.18.0.1) is the Docker bridge gateway on the machine
# this file was written on. It is NOT portable — it depends on which networks
# Docker created and in what order. Set it explicitly.
#
# How to find the right value:
#   kind / k3d on the same host   docker network inspect kind -f '{{(index .IPAM.Config 0).Gateway}}'
#   Docker Desktop (mac/windows)  ws://host.docker.internal:8083
#   cluster on another machine    ws://<LAN or public IP of this host>:8083
#   behind TLS                    wss://<hostname>   (no port if fronted by 443)
#
# If the agent stays disconnected with no error in the UI, this is the first
# thing to check.
NAVYR_PUBLIC_WS_URL=ws://172.18.0.1:8083

# ── Dev/test overrides (never enable in production) ──────────────────────────
CLUSTER_VALIDATION_MODE=real
